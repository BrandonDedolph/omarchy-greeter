#!/bin/bash
# Publish a new version as a signed GitHub release.
#
#   scripts/release 3.1.0      release a new version
#   scripts/release --aur-only write aur/ and push it to the AUR (for when AUR
#                              registration reopens; see issue #1)
#
# A release:
# 1. checks the tree is clean and in sync with origin, and runs `make check`;
# 2. sets the version in PKGBUILD and commits;
# 3. builds the package from the tagged code (a clean export, not this tree);
# 4. signs it with the release key (an SSH key held in 1Password, so 1Password
#    asks to approve) and checks the signature against keys/allowed_signers;
# 5. pushes, and creates the GitHub release with the package, its signature
#    and install.sh (with the release key built in), notes from the commits.
#    The tag is created only once the package is built and signed.
#
# Installed copies pick it up through `omarchy update` (omarchy-greeter update).

set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
SIGNING_KEY=${SIGNING_KEY:-$HOME/.ssh/omarchy-greeter-release.pub}
AGENT=${OMARCHY_GREETER_SIGN_AGENT:-$HOME/.1password/agent.sock}
AUR_DIR=${AUR_DIR:-$HOME/ghq/aur.archlinux.org/omarchy-greeter}
NAMESPACE=omarchy-greeter-release

step() { printf '\n\e[1m==> %s\e[0m\n' "$*"; }
die() { echo "release: $*" >&2; exit 1; }

sign() {  # sign <file>: writes <file>.sig and checks it against keys/allowed_signers
  rm -f "$1.sig"
  SSH_AUTH_SOCK=$AGENT ssh-keygen -q -Y sign -f "$SIGNING_KEY" -n "$NAMESPACE" "$1" || { echo "release: signing $1 failed" >&2; return 1; }
  ssh-keygen -Y verify -f keys/allowed_signers -I "$NAMESPACE" -n "$NAMESPACE" -s "$1.sig" < "$1" >/dev/null ||
    { echo "release: the signature for $1 does not verify against keys/allowed_signers" >&2; return 1; }
}

# ---- AUR (later) --------------------------------------------------------

aur_only() {
  local version url tarball sum
  version=$(sed -n 's/^pkgver=//p' PKGBUILD)
  git rev-parse -q --verify "refs/tags/v$version" >/dev/null || die "v$version is not tagged"
  url=$(sed -n 's/^url="\(.*\)"/\1/p' PKGBUILD)
  tarball=$(mktemp)
  curl -fsSL -o "$tarball" "$url/archive/refs/tags/v$version.tar.gz"
  sum=$(sha256sum "$tarball" | cut -d' ' -f1)
  rm -f "$tarball"
  mkdir -p aur
  {
    echo "# Maintainer: BrandonDedolph <https://github.com/BrandonDedolph>"
    echo "# Generated by scripts/release from the repository's PKGBUILD; edit there."
    sed -n '/^pkgname=/,/^install=/p' PKGBUILD
    echo "makedepends=(make)"
    echo "source=(\"\$pkgname-\$pkgver.tar.gz::\$url/archive/refs/tags/v\$pkgver.tar.gz\")"
    echo "sha256sums=('$sum')"
    echo
    echo "package() {"
    echo "  cd \"\$pkgname-\$pkgver\""
    echo "  make DESTDIR=\"\$pkgdir\" install"
    echo "}"
  } > aur/PKGBUILD
  cp omarchy-greeter.install aur/
  (cd aur && makepkg --printsrcinfo > .SRCINFO)
  [[ -d $AUR_DIR/.git ]] ||
    die "clone the AUR repo first: git clone ssh://aur@aur.archlinux.org/omarchy-greeter.git $AUR_DIR"
  cp aur/PKGBUILD aur/.SRCINFO aur/omarchy-greeter.install "$AUR_DIR/"
  git -C "$AUR_DIR" add PKGBUILD .SRCINFO omarchy-greeter.install
  if git -C "$AUR_DIR" diff --cached --quiet; then
    echo "The AUR already has $version."
  else
    git -C "$AUR_DIR" commit -q -m "Update to $version"
    git -C "$AUR_DIR" push -q origin HEAD:master
    echo "Published $version to the AUR."
  fi
}

if [[ ${1:-} == "--aur-only" ]]; then
  aur_only
  exit 0
fi

# ---- release ------------------------------------------------------------

version=${1:-}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: scripts/release <major.minor.patch> | --aur-only" >&2; exit 2; }
tag="v$version"

step "Checking"
[[ $(git branch --show-current) == "main" ]] || die "not on main"
[[ -z $(git status --porcelain) ]] || die "uncommitted changes"
git fetch -q origin
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || die "main is not in sync with origin/main"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "$tag already exists"
[[ -r $SIGNING_KEY ]] || die "release key not found at $SIGNING_KEY"
grep -qF "$(cut -d' ' -f2 "$SIGNING_KEY")" keys/allowed_signers || die "$SIGNING_KEY is not in keys/allowed_signers"
make check

step "Versioning $tag"
sed -i -E "s/^pkgver=.*/pkgver=$version/; s/^pkgrel=.*/pkgrel=1/" PKGBUILD
sed -i -E "s/^Version=.*/Version=$version/" theme/metadata.desktop
if [[ -n $(git status --porcelain PKGBUILD theme/metadata.desktop) ]]; then
  git commit -q -m "Release $tag" PKGBUILD theme/metadata.desktop
fi

# Undo the version commit if anything below fails before publishing.
release_commit=$(git rev-parse HEAD)
undo() {
  if [[ $(git rev-parse HEAD) == "$release_commit" && $release_commit != $(git rev-parse origin/main) ]]; then
    git reset -q --hard origin/main
  fi
  return 0
}

step "Building $version"
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
git archive HEAD | tar -x -C "$build"
(cd "$build" && makepkg -f --noconfirm >/dev/null) || { undo; die "the package does not build"; }
pkg="$build/omarchy-greeter-$version-1-any.pkg.tar.zst"
[[ -f $pkg ]] || die "expected $pkg"
sed "s|@ALLOWED_SIGNERS@|$(grep -v '^#' keys/allowed_signers | head -n1)|" scripts/install.sh > "$build/install.sh"

step "Signing (approve in 1Password)"
sign "$pkg" || { undo; exit 1; }
sign "$build/install.sh" || { undo; exit 1; }

step "Publishing"
git tag -a "$tag" -m "omarchy-greeter $version"
git push -q origin main "$tag"
gh release create "$tag" --verify-tag --title "omarchy-greeter $version" --generate-notes \
  "$pkg" "$pkg.sig" "$build/install.sh" "$build/install.sh.sig"
echo
echo "Released $tag: https://github.com/BrandonDedolph/omarchy-greeter/releases/tag/$tag"
