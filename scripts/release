#!/bin/bash
# Publish a new version: GitHub release + AUR package.
#
#   scripts/release 3.1.0      release a new version
#   scripts/release --aur-only push the current aur/ package to the AUR
#                              (e.g. the first time, once the AUR repo is cloned)
#
# 1. checks the tree is clean and in sync, and runs `make check`;
# 2. sets the version in PKGBUILD, commits, tags v<version>, pushes;
# 3. creates the GitHub release (notes from the commits since the last tag);
# 4. writes aur/PKGBUILD (from PKGBUILD, building the release tarball, with its
#    checksum) and aur/.SRCINFO, and test-builds the package from it;
# 5. pushes aur/ to the AUR, if the AUR repository is cloned at $AUR_DIR
#    (default ~/ghq/aur.archlinux.org/omarchy-greeter).
#
# Users then get the update through `omarchy update` (or `yay`).

set -euo pipefail

push_aur() {
  [[ -d $AUR_DIR/.git ]] || return 1
  local version
  version=$(sed -n 's/^pkgver=//p' aur/PKGBUILD)
  cp aur/PKGBUILD aur/.SRCINFO aur/omarchy-greeter.install "$AUR_DIR/"
  git -C "$AUR_DIR" add PKGBUILD .SRCINFO omarchy-greeter.install
  if git -C "$AUR_DIR" diff --cached --quiet; then
    echo "The AUR already has $version."
    return 0
  fi
  git -C "$AUR_DIR" commit -q -m "Update to $version"
  git -C "$AUR_DIR" push -q origin HEAD:master
  echo "Published $version to the AUR."
}

version=${1:-}
root=$(git rev-parse --show-toplevel)
cd "$root"
AUR_DIR=${AUR_DIR:-$HOME/ghq/aur.archlinux.org/omarchy-greeter}

if [[ $version == "--aur-only" ]]; then
  push_aur || { echo "release: clone the AUR repo first: git clone ssh://aur@aur.archlinux.org/omarchy-greeter.git $AUR_DIR" >&2; exit 1; }
  exit 0
fi

[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: scripts/release <major.minor.patch>" >&2; exit 2; }
tag="v$version"

step() { printf '\n\e[1m==> %s\e[0m\n' "$*"; }
die() { echo "release: $*" >&2; exit 1; }

step "Checking"
[[ $(git branch --show-current) == "main" ]] || die "not on main"
[[ -z $(git status --porcelain) ]] || die "uncommitted changes"
git fetch -q origin
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || die "main is not in sync with origin/main"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "$tag already exists"
make check

step "Versioning $tag"
sed -i -E "s/^pkgver=.*/pkgver=$version/; s/^pkgrel=.*/pkgrel=1/" PKGBUILD
if [[ -n $(git status --porcelain PKGBUILD) ]]; then
  git commit -q -m "Release $tag" PKGBUILD
fi
git tag -a "$tag" -m "omarchy-greeter $version"
git push -q origin main "$tag"

step "GitHub release"
gh release create "$tag" --title "omarchy-greeter $version" --generate-notes --verify-tag

step "AUR package"
url=$(sed -n 's/^url="\(.*\)"/\1/p' PKGBUILD)
mkdir -p aur
tarball=$(mktemp)
trap 'rm -f "$tarball"' EXIT
curl -fsSL -o "$tarball" "$url/archive/refs/tags/$tag.tar.gz"
sum=$(sha256sum "$tarball" | cut -d' ' -f1)
{
  echo "# Maintainer: BrandonDedolph <https://github.com/BrandonDedolph>"
  echo "# Generated by scripts/release from the repository's PKGBUILD; edit there."
  sed -n '/^pkgname=/,/^install=/p' PKGBUILD
  echo "makedepends=(make)"
  echo "source=(\"\$pkgname-\$pkgver.tar.gz::\$url/archive/refs/tags/v\$pkgver.tar.gz\")"
  echo "sha256sums=('$sum')"
  echo
  echo "package() {"
  echo "  cd \"\$pkgname-\$pkgver\""
  echo "  make DESTDIR=\"\$pkgdir\" install"
  echo "}"
} > aur/PKGBUILD
cp omarchy-greeter.install aur/
(cd aur && makepkg --printsrcinfo > .SRCINFO)

step "Test build from the release"
build=$(mktemp -d)
cp aur/PKGBUILD aur/omarchy-greeter.install "$build/"
(cd "$build" && makepkg -f --noconfirm >/dev/null) || die "the AUR package does not build; see $build"
ls "$build"/*.pkg.tar.* >/dev/null
rm -rf "$build"

git add aur
git commit -q -m "AUR package for $tag"
git push -q origin main

step "AUR"
if ! push_aur; then
  echo "AUR repository not cloned at $AUR_DIR. To publish there:"
  echo "  git clone ssh://aur@aur.archlinux.org/omarchy-greeter.git $AUR_DIR"
  echo "  scripts/release --aur-only"
fi
