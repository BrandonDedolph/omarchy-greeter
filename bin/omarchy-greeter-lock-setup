#!/bin/bash
# Improve the Omarchy lock screen (see /usr/lib/omarchy-greeter/patch-lock.py):
# primary monitor only, who is signed in, and switching user. Clones the built-in lock
# plugin (`omarchy plugin clone omarchy.lock`) and patches the clone.
#
# The clone is a snapshot, so it would miss Omarchy's later lock fixes. To
# avoid that, re-running this (the installed post-update hook does it after
# every `omarchy update`) throws the old clone away and re-clones fresh.
# If the built-in lock code changed so the patch no longer fits, it stops
# and leaves you on the built-in lock (form on every monitor) instead.
#
#   omarchy-greeter-lock-setup           clone fresh and patch
#   omarchy-greeter-lock-setup --ensure  set up once, unless already done or opted out
#   omarchy-greeter-lock-setup --remove  go back to the built-in lock (and opt out)

set -euo pipefail

ID="${USER:-$(id -un)}.lock"
DIR="$HOME/.config/omarchy/plugins/$ID"
MARK="omarchy-greeter:primary-lock"
OPTOUT="$HOME/.config/omarchy-greeter/no-primary-lock"
HOOK="$HOME/.config/omarchy/hooks/post-update.d/omarchy-greeter-lock"

remove_clone() {
  if [[ -d $DIR ]]; then
    if ! grep -q "$MARK" "$DIR/Service.qml" 2>/dev/null; then
      echo "omarchy-greeter-lock-setup: $DIR was not made by this script; leaving it alone" >&2
      exit 1
    fi
    omarchy plugin remove "$ID" --yes >/dev/null
  fi
}

if [[ ${1:-} == --remove ]]; then
  remove_clone
  rm -f "$HOOK"
  mkdir -p "${OPTOUT%/*}" && touch "$OPTOUT"
  echo "Back to the built-in Omarchy lock screen."
  exit 0
fi

if [[ ${1:-} == --ensure ]]; then
  [[ -e $OPTOUT || -d $DIR ]] && exit 0
fi
rm -f "$OPTOUT"

remove_clone
omarchy plugin clone omarchy.lock >/dev/null

if ! python3 -I "${OMARCHY_GREETER_PATCH:-/usr/lib/omarchy-greeter/patch-lock.py}" "$DIR" "$MARK"; then
  echo "omarchy-greeter-lock-setup: the built-in lock changed and the patch no longer fits; staying on the built-in lock" >&2
  omarchy plugin remove "$ID" --yes >/dev/null || true
  exit 1
fi

# The lock is a keep-loaded plugin: the built-in stays running (and keeps
# answering `omarchy system lock`) until the shell restarts.
omarchy restart shell >/dev/null 2>&1 || omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
# Re-clone after each `omarchy update` so the lock keeps Omarchy's fixes.
mkdir -p "${HOOK%/*}"
install -m 755 /usr/share/omarchy-greeter/hooks/post-update "$HOOK" 2>/dev/null || true
echo "Lock screen now shows on the primary monitor only ($DIR)."
