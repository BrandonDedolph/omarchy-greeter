#!/bin/bash
# For the lock screen: who I am, which other accounts are signed in on this
# machine right now (graphical sessions only), and every account the login
# screen lists (for the account list), each marked signed in or not.
set -euo pipefail

# Demo data for screenshots ($XDG_RUNTIME_DIR is private to this account and
# cleared at logout): {"me":{...},"others":[...]}
demo="${XDG_RUNTIME_DIR:-/nonexistent}/omarchy-greeter-demo.json"
if [[ -f $demo && -O $demo ]]; then
  cat "$demo"
  exit 0
fi
me=$(id -un)
avatar="/var/lib/omarchy-greeter/$me/avatar.png"
[[ -r $avatar ]] || avatar=""
real_name() { getent passwd "$1" | cut -d: -f5 | cut -d, -f1; }

# Same rule as the login screen: a graphical (wayland/x11) session that is
# not on its way out.
others=""
for sid in $(loginctl list-sessions --json=short 2>/dev/null |
  jq -r --arg me "$me" '.[] | select(.user != $me and .class == "user" and .seat != null) | .session' 2>/dev/null); do
  [[ $sid =~ ^[0-9a-zA-Z]+$ ]] || continue
  read -r user type state < <(loginctl show-session "$sid" --property=Name --property=Type --property=State --value 2>/dev/null | paste -sd' ')
  [[ $state != closing && ( $type == wayland || $type == x11 ) && -n $user ]] && others+="$user"$'\n'
done
others=$(printf '%s' "$others" | sort -u)

# Accounts the login screen offers: regular uids with a login shell.
accounts=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { split($5, gecos, ","); print $1 "\t" gecos[1] }')

{
  printf '%s\t%s\n' "$me" "$(real_name "$me")"
  for user in $others; do printf '%s\t%s\n' "$user" "$(real_name "$user")"; done
} | jq -R -s -c '
  split("\n") | map(select(length > 0) | split("\t") | {name: .[0], realName: (.[1] // "")})
  | {me: .[0], others: .[1:]}' |
  jq -c --arg avatar "$avatar" --arg accounts "$accounts" --arg others "$others" '
    .me.avatar = $avatar
    | ($others | split("\n") | map(select(length > 0))) as $on
    | .accounts = ($accounts | split("\n") | map(split("\t") | select(.[0] | test("^[a-z_][a-z0-9_-]{0,31}$")))
        | map({name: .[0], realName: (.[1] // ""), signedIn: (.[0] as $n | $on | index($n) != null)}))'
