#!/bin/bash
# Tells the login screen whether this account has a session running, so it
# can show "Locked" (logging in resumes it) or "Log in" (starts a new one).
# Writes the logind session id; the login screen also checks that logind
# still knows the session, so a crashed session does not show as running.
dir="/var/lib/omarchy-greeter/$(id -un)"
[[ -d $dir && -w $dir ]] || exit 0
case ${1:-} in
  start)
    [[ ${XDG_SESSION_ID:-} =~ ^[0-9a-zA-Z]+$ ]] || exit 0
    printf '%s\n' "$XDG_SESSION_ID" > "$dir/.session.tmp" && chmod 644 "$dir/.session.tmp" && mv -f "$dir/.session.tmp" "$dir/session"
    ;;
  stop) rm -f "$dir/session" ;;
esac
