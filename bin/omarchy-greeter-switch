#!/bin/bash
# Open the login screen on a new console while this session stays as it is
# (call it from the lock screen, so it stays locked). With a user name, the
# login screen opens with that account selected.
set -euo pipefail
target=${1:-}
dir="/var/lib/omarchy-greeter/$(id -un)"
# A plain switch clears any earlier choice, so it is never replayed.
[[ -n $target && $target =~ ^[a-z_][a-z0-9_-]*$ ]] || target=""
if [[ -w $dir ]]; then
  if [[ -z $target ]]; then rm -f "$dir/switch-to"; fi
fi
if [[ -n $target && -w $dir ]]; then
  printf '%s %s\n' "$(date +%s)" "$target" > "$dir/.switch-to.tmp"
  chmod 600 "$dir/.switch-to.tmp"
  mv -f "$dir/.switch-to.tmp" "$dir/switch-to"
  # publish-view copies it for the login screen within moments; give it a
  # head start on the login screen opening.
  sleep 0.3
fi
exec busctl --system call org.freedesktop.DisplayManager /org/freedesktop/DisplayManager/Seat0 \
  org.freedesktop.DisplayManager.Seat SwitchToGreeter
