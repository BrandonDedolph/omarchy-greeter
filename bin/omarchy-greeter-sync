#!/bin/bash
# Publish this user's current Omarchy look for the login screen.
#
# The SDDM greeter runs as the `sddm` user and cannot read anyone's home, so
# each user copies a screen-sized still of their background, their theme
# colors, their avatar and their display sizing into
# /var/lib/omarchy-greeter/<user>/, a private folder they own. A root service
# (publish-view) checks every file there and copies it for the greeter.
#
# Runs from two places:
#   - in the user's session, from a systemd user path unit, whenever their
#     theme, background, monitors, shell font or avatar changes;
#   - at boot, before the login screen, as each user (--offline), so the
#     login screen knows every account's look even if it has never logged in
#     on this boot or since the package was installed.
#
#   omarchy-greeter-sync [--now] [--offline]
#     --now      skip the short settle delay
#     --offline  not inside a session: read monitors from the Hyprland config
#                instead of hyprctl, and skip the lock screen setup

set -euo pipefail

now=0 offline=0
for arg in "$@"; do
  case $arg in
    --now) now=1 ;;
    --offline) offline=1; now=1 ;;
  esac
done

ROOT=${OMARCHY_GREETER_DIR:-/var/lib/omarchy-greeter}
USER_NAME=$(id -un)
DEST="$ROOT/$USER_NAME"
STATE="$HOME/.local/state/omarchy/current"
MAX_W=3840
MAX_H=2160
MAX_VIDEO_BYTES=$((150 * 1024 * 1024))

log() { echo "omarchy-greeter-sync: $*" >&2; }

# The menu entries, update hook and lock screen, kept current from inside a
# session whether or not this account publishes its look.
session_setup() {
  (( ! offline )) && [[ -z ${OMARCHY_GREETER_DIR:-} ]] || return 0
  if command -v omarchy-greeter >/dev/null; then
    omarchy-greeter menu ensure >/dev/null || log "could not add the menu entries"
    omarchy-greeter hook || log "could not install the update hook"
  fi
  if command -v omarchy-greeter-lock-setup >/dev/null; then
    omarchy-greeter-lock-setup --ensure || log "lock screen setup failed; will retry next time"
  fi
}

# Opted out (omarchy-greeter publish off): the login screen shows the
# default look for this account.
if [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-greeter/no-publish ]]; then
  session_setup
  exit 0
fi

if [[ ! -d $DEST || ! -w $DEST ]]; then
  log "$DEST is missing or not writable; run: sudo systemctl start omarchy-greeter-dirs"
  exit 0
fi

# A theme switch rewrites several files in a row; let it settle first.
(( now )) || sleep 1.5

# Left by a run that was killed.
find "$DEST" -maxdepth 1 -name '.sync.*' -type d -mmin +10 -exec rm -rf {} + 2>/dev/null || true
work=$(mktemp -d "$DEST/.sync.XXXXXX")
trap 'rm -rf "$work"' EXIT

# ---- theme --------------------------------------------------------------

colors="$STATE/theme/colors.toml"
bgcolor="#1a1b26"
if [[ -r $colors ]]; then
  cp "$colors" "$work/colors.toml"
  value=$(sed -nE 's/^[[:space:]]*background[[:space:]]*=[[:space:]]*"(#[0-9a-fA-F]{6})".*/\1/p' "$colors" | head -n1)
  [[ -n $value ]] && bgcolor=$value
fi
[[ -r $STATE/theme.name ]] && cp "$STATE/theme.name" "$work/theme.name"

# ---- background ---------------------------------------------------------
# Converting a 4K+ wallpaper takes a moment, so it is redone only when the
# file, its modification time or the theme color behind it changed.

background=$(readlink -f "$STATE/background" 2>/dev/null || true)
video=""
source_key=""
[[ -n $background && -f $background ]] && source_key="$background $(stat -c %Y "$background") $bgcolor"
unchanged=0
if [[ -n $source_key && -r $DEST/source && $(<"$DEST/source") == "$source_key" && -e $DEST/background.jpg ]]; then
  unchanged=1
  cp "$DEST/background.jpg" "$work/background.jpg"
  video=$(cat "$DEST/video" 2>/dev/null || true)
  [[ -n $video && -e $DEST/$video ]] || video=""
fi

if (( ! unchanged )) && [[ -n $source_key ]]; then
  case "${background,,}" in
    *.mp4|*.webm|*.mkv|*.mov|*.m4v)
      ext="${background##*.}"
      ext="${ext,,}"
      # The still is shown at once and stays as the fallback if video fails.
      ffmpeg -v error -y -i "$background" -frames:v 1 \
        -vf "scale='min($MAX_W,iw)':'min($MAX_H,ih)':force_original_aspect_ratio=increase" \
        -q:v 3 "$work/background.jpg" || true
      if (( $(stat -c %s "$background") <= MAX_VIDEO_BYTES )); then
        cp "$background" "$work/background.$ext"
        video="background.$ext"
      else
        log "video larger than $((MAX_VIDEO_BYTES / 1024 / 1024)) MB; using its first frame only"
      fi
      ;;
    *)
      # First frame only, flattened onto the theme color (some stock
      # backgrounds are transparent), shrunk to at most 4K.
      magick "${background}[0]" -background "$bgcolor" -alpha remove -alpha off \
        -resize "${MAX_W}x${MAX_H}^>" -strip -quality 90 "$work/background.jpg" ||
        log "could not convert $background"
      ;;
  esac
fi
[[ -n $source_key ]] && printf '%s\n' "$source_key" > "$work/source"

# ---- avatar -------------------------------------------------------------

for face in "$HOME/.face" "$HOME/.face.icon"; do
  if [[ -r $face ]]; then
    magick "${face}[0]" -resize '256x256^' -gravity center -extent 256x256 -strip "$work/avatar.png" 2>/dev/null || true
    break
  fi
done

# ---- sizing -------------------------------------------------------------
# So the login screen matches the desktop: the font and base size the
# Omarchy shell uses, and each monitor's mode, position and scale. Inside a
# session hyprctl reports what is live; otherwise the monitors come from the
# user's Hyprland config (~/.config/hypr/monitors.lua).

font_family=$(omarchy-font-current 2>/dev/null || fc-match -f '%{family[0]}' monospace 2>/dev/null || echo monospace)
font_size=""
for toml in "$HOME/.config/omarchy/shell.toml" "$STATE/theme/shell.toml"; do
  [[ -r $toml ]] || continue
  font_size=$(awk -F= '/^[[:space:]]*\[/{s=$0; gsub(/[[:space:]]/,"",s)} s=="[font]" && $1 ~ /^[[:space:]]*base-size[[:space:]]*$/ {gsub(/[^0-9.]/,"",$2); print $2; exit}' "$toml")
  [[ -n $font_size ]] && break
done

monitors_from_config() {
  local file="$HOME/.config/hypr/monitors.lua"
  [[ -r $file ]] || { echo '{}'; return; }
  # hl.monitor({ output = "DP-1", mode = "3840x2160@120", position = "0x0", scale = 1 })
  { grep -E '^[[:space:]]*hl\.monitor\(' "$file" || true; } | while IFS= read -r line; do
    output=$(sed -nE 's/.*output[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' <<<"$line")
    [[ -n $output ]] || continue
    mode=$(sed -nE 's/.*mode[[:space:]]*=[[:space:]]*"([0-9]+x[0-9]+(@[0-9.]+)?)".*/\1/p' <<<"$line")
    position=$(sed -nE 's/.*position[[:space:]]*=[[:space:]]*"(-?[0-9]+x-?[0-9]+)".*/\1/p' <<<"$line")
    scale=$(sed -nE 's/.*scale[[:space:]]*=[[:space:]]*"?([0-9.]+)"?.*/\1/p' <<<"$line")
    transform=$(sed -nE 's/.*transform[[:space:]]*=[[:space:]]*"?([0-7])"?.*/\1/p' <<<"$line")
    jq -n --arg name "$output" --arg mode "$mode" --arg position "$position" --arg scale "$scale" --arg transform "$transform" '
      ($mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)(@(?<r>[0-9.]+))?$")? // {}) as $m
      | ($position | capture("^(?<x>-?[0-9]+)x(?<y>-?[0-9]+)$")? // {}) as $p
      | {($name): ({}
          + (if $scale != "" then {scale: ($scale | tonumber)} else {} end)
          + (if $transform != "" then {transform: ($transform | tonumber)} else {} end)
          + (if $m.w then {width: ($m.w | tonumber), height: ($m.h | tonumber)} else {} end)
          + (if $m.r then {refresh: ($m.r | tonumber)} else {} end)
          + (if $p.x then {x: ($p.x | tonumber), y: ($p.y | tonumber)} else {} end))}'
  done | jq -s -c 'add // {}'
}

monitors=""
if (( ! offline )); then
  monitors=$(hyprctl monitors -j 2>/dev/null | jq -c '
    map({(.name): {scale, width, height, refresh: .refreshRate, x, y, transform}}) | add // {}' 2>/dev/null || true)
elif [[ -r $DEST/display.json && ! $HOME/.config/hypr/monitors.lua -nt $DEST/display.json ]]; then
  # At boot: what the desktop last reported live is more complete than what
  # the config spells out (mode "preferred", position "auto"), unless the
  # config changed since.
  monitors=$(jq -c '.monitors // {}' "$DEST/display.json" 2>/dev/null || true)
fi
[[ -n $monitors && $monitors != "{}" ]] || monitors=$(monitors_from_config)
if [[ -z $monitors || $monitors == "{}" ]] && [[ -r $DEST/display.json ]]; then
  monitors=$(jq -c '.monitors // {}' "$DEST/display.json" 2>/dev/null || echo '{}')
fi
jq -n --arg family "$font_family" --arg size "${font_size:-12}" --argjson monitors "${monitors:-{\}}" \
  '{fontFamily: $family, fontBaseSize: ($size | tonumber), monitors: $monitors}' > "$work/display.json"

# The same monitors as plain lines for the login screen's compositor, so it
# drives the displays exactly as the desktop does (no mode change, and so no
# blackout, when switching between them):  name WxH@R XxY scale
jq -r '.monitors | to_entries[] | select(.value.width and .value.height)
  | "\(.key) \(.value.width)x\(.value.height)@\((.value.refresh // 60) * 1000 | round / 1000) \(.value.x // 0)x\(.value.y // 0) \(.value.scale // 1) \(.value.transform // 0)"' \
  "$work/display.json" > "$work/monitors"

printf '%s\n' "$video" > "$work/video"
if (( unchanged )) && [[ -r $DEST/updated ]]; then cp "$DEST/updated" "$work/updated"; else date +%s > "$work/updated"; fi

# ---- publish ------------------------------------------------------------
# Move each file into place on its own, so the greeter never sees a half-
# written image, then drop what this run no longer publishes.
chmod 600 "$work"/*
for name in colors.toml theme.name background.jpg avatar.png display.json monitors source video updated; do
  if [[ -e $work/$name ]]; then
    mv -f "$work/$name" "$DEST/$name"
  elif [[ $name != video && $name != updated ]]; then
    rm -f "$DEST/$name"
  fi
done
for old in "$DEST"/background.{mp4,webm,mkv,mov,m4v}; do
  [[ -e $old && $(basename "$old") != "$video" ]] && rm -f "$old"
done
[[ -n $video && -e $work/$video ]] && mv -f "$work/$video" "$DEST/$video"

log "published ${background:-no background} for $USER_NAME$( (( unchanged )) && echo ' (background unchanged)')"

session_setup
