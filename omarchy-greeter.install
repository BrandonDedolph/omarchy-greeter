PAM_FILE=/etc/pam.d/sddm
PAM_LINE='auth        [success=done default=ignore] pam_exec.so quiet /usr/lib/omarchy-greeter/boot-unlock-auth'
USER_UNITS=(omarchy-greeter-sync.path omarchy-greeter-sync.service omarchy-greeter-guard.service omarchy-greeter-lock-update.service)
SYSTEM_UNITS=(omarchy-greeter-dirs.service omarchy-greeter-boot-unlock.service omarchy-greeter-sessions.path)

SESSION_LINE='session     optional    pam_exec.so quiet /usr/lib/omarchy-greeter/boot-unlock-auth'

# Two lines in /etc/pam.d/sddm: one before the first auth line, so it is
# checked first and falls through to the normal password check whenever it
# does not apply; one at the end of the session stack, so the first login of
# the boot (whoever it is) uses the boot pass up. Built next to the file and
# renamed over it, so it is never half-written.
add_pam_line() {
  [[ -f $PAM_FILE ]] || return 0
  local tmp
  tmp=$(mktemp "$PAM_FILE.omarchy-greeter.XXXXXX") || return 0
  awk -v auth="$PAM_LINE" -v session="$SESSION_LINE" '
    /boot-unlock-auth/ { next }
    !done && /^[[:space:]]*-?auth[[:space:]]/ { print auth; done=1 }
    { print }
    END { print session }' "$PAM_FILE" > "$tmp"
  if grep -qxF "$PAM_LINE" "$tmp" && grep -qxF "$SESSION_LINE" "$tmp"; then
    cmp -s "$tmp" "$PAM_FILE" || { chmod 644 "$tmp" && chown root:root "$tmp" && mv -f "$tmp" "$PAM_FILE"; }
  fi
  rm -f "$tmp"
}

remove_pam_line() {
  [[ -f $PAM_FILE ]] && sed -i '/omarchy-greeter\/boot-unlock-auth/d' "$PAM_FILE"
}

# Run a command as every account with a home folder (never as root in
# someone's home, where a planted link could redirect it).
for_each_account() {
  local user home
  while IFS=: read -r user _ uid _ _ home _; do
    (( uid >= 1000 && uid < 60000 )) && [[ -d $home ]] || continue
    runuser -u "$user" -- env HOME="$home" USER="$user" "$@" >/dev/null 2>&1 < /dev/null || true
  done < <(getent passwd)
}

post_install() {
  systemctl daemon-reload
  systemctl enable "${SYSTEM_UNITS[@]}"
  systemctl --global enable "${USER_UNITS[@]}"
  add_pam_line
  systemctl start omarchy-greeter-sessions.path || true
  # Publish and check every account's look now, not just at next boot.
  systemctl start omarchy-greeter-dirs.service || true
  # The menu entries and update hook are plain files: add them now, as each
  # account (the lock screen waits for the next login, which loads it).
  for_each_account /usr/bin/omarchy-greeter menu ensure
  for_each_account /usr/bin/omarchy-greeter hook
  echo ">> Log out (or reboot) to see the new login screen. Settings: Setup > Login & Lock in the Omarchy menu, or omarchy-greeter status."
}

post_upgrade() {
  # Before 1.0.2 each session announced itself (omarchy-greeter-presence);
  # now a root service asks logind.
  rm -f /etc/systemd/user/graphical-session.target.wants/omarchy-greeter-presence.service
  systemctl daemon-reload
  systemctl enable omarchy-greeter-sessions.path
  systemctl start omarchy-greeter-sessions.path || true
  systemctl --global enable "${USER_UNITS[@]}"
  add_pam_line
  systemctl restart omarchy-greeter-dirs.service || true
  for_each_account /usr/bin/omarchy-greeter menu ensure
  for_each_account /usr/bin/omarchy-greeter hook
  if grep -qE '^[[:space:]]*boot_unlock[[:space:]]*=[[:space:]]*yes' /etc/omarchy-greeter.conf 2>/dev/null; then
    echo ">> One password at boot now names the accounts that may use it. Turn it back on for yours with: omarchy-greeter boot-pass on"
  fi
}

pre_remove() {
  # Take the Setup > Login & Lock rows out of every account's Omarchy menu,
  # the update hook, and put Omarchy's own lock screen back.
  for_each_account /usr/bin/omarchy-greeter menu purge
  # shellcheck disable=SC2016  # $HOME expands in the account's own shell
  for_each_account sh -c 'rm -f "$HOME/.config/omarchy/hooks/post-update.d/omarchy-greeter" "$HOME/.config/omarchy/hooks/post-update.d/omarchy-greeter-lock"'
  for_each_account /usr/bin/omarchy-greeter-lock-setup --uninstall
  remove_pam_line
  local units=()
  mapfile -t units < <(systemctl list-units --plain --no-legend --all 'omarchy-greeter-view@*' 2>/dev/null | awk '{print $1}')
  (( ${#units[@]} )) && systemctl stop "${units[@]}" 2>/dev/null
  true
  systemctl disable --now "${SYSTEM_UNITS[@]}" omarchy-greeter-sessions.service || true
  systemctl --global disable "${USER_UNITS[@]}" || true
  rm -f /run/omarchy-greeter/boot-unlocked
}

post_remove() {
  rm -rf /var/lib/omarchy-greeter /run/omarchy-greeter
  rm -f /var/lib/sddm/omarchy-greeter-selected
  echo ">> Log out and back in so a running desktop switches back to Omarchy's lock screen."
}
