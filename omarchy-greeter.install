PAM_FILE=/etc/pam.d/sddm
PAM_LINE='auth        [success=done default=ignore] pam_exec.so quiet /usr/lib/omarchy-greeter/boot-unlock-auth'
USER_UNITS='omarchy-greeter-sync.path omarchy-greeter-sync.service omarchy-greeter-presence.service omarchy-greeter-guard.service omarchy-greeter-lock-update.service'

add_pam_line() {
  [[ -f $PAM_FILE ]] || return 0
  grep -qF 'boot-unlock-auth' "$PAM_FILE" && return 0
  # Before the first auth line, so it is checked first and falls through to
  # the normal password check whenever it does not apply. Built outside
  # /etc/pam.d and swapped in whole.
  local tmp
  tmp=$(mktemp) || return 0
  if awk -v line="$PAM_LINE" '!done && /^[[:space:]]*-?auth[[:space:]]/ { print line; done=1 } { print }' "$PAM_FILE" > "$tmp" &&
    grep -qF 'boot-unlock-auth' "$tmp"; then
    install -m 644 -o root -g root "$tmp" "$PAM_FILE"
  fi
  rm -f "$tmp"
}

remove_pam_line() {
  [[ -f $PAM_FILE ]] && sed -i '/omarchy-greeter\/boot-unlock-auth/d' "$PAM_FILE"
}

# Run a command as every account with a home folder (never as root in
# someone's home, where a planted link could redirect it).
for_each_account() {
  local user home
  while IFS=: read -r user _ uid _ _ home _; do
    (( uid >= 1000 && uid < 60000 )) && [[ -d $home ]] || continue
    runuser -u "$user" -- env HOME="$home" USER="$user" "$@" >/dev/null 2>&1 < /dev/null || true
  done < <(getent passwd)
}

post_install() {
  systemctl daemon-reload
  systemctl enable omarchy-greeter-dirs.service omarchy-greeter-boot-unlock.service
  systemctl --global enable $USER_UNITS
  add_pam_line
  # Publish and check every account's look now, not just at next boot.
  systemctl start omarchy-greeter-dirs.service || true
  echo ">> Log out (or reboot) to see the new login screen. Settings: Setup > Login & Lock in the Omarchy menu, or omarchy-greeter status."
}

post_upgrade() {
  systemctl daemon-reload
  systemctl --global enable $USER_UNITS
  add_pam_line
  systemctl restart omarchy-greeter-dirs.service || true
  if grep -qE '^[[:space:]]*boot_unlock[[:space:]]*=[[:space:]]*yes' /etc/omarchy-greeter.conf 2>/dev/null; then
    echo ">> One password at boot now names the accounts that may use it. Turn it back on for yours with: omarchy-greeter boot-pass on"
  fi
}

pre_remove() {
  # Take the Setup > Login & Lock rows out of every account's Omarchy menu,
  # the update hook, and put Omarchy's own lock screen back.
  for_each_account /usr/bin/omarchy-greeter menu purge
  for_each_account sh -c 'rm -f "$HOME/.config/omarchy/hooks/post-update.d/omarchy-greeter" "$HOME/.config/omarchy/hooks/post-update.d/omarchy-greeter-lock"'
  for_each_account /usr/bin/omarchy-greeter-lock-setup --uninstall
  remove_pam_line
  local units
  units=$(systemctl list-units --plain --no-legend --all 'omarchy-greeter-view@*' 2>/dev/null | awk '{print $1}')
  systemctl stop $units 2>/dev/null || true
  systemctl disable --now omarchy-greeter-dirs.service omarchy-greeter-boot-unlock.service || true
  systemctl --global disable $USER_UNITS || true
  rm -f /run/omarchy-greeter/boot-unlocked
}

post_remove() {
  rm -rf /var/lib/omarchy-greeter /run/omarchy-greeter
  rm -f /var/lib/sddm/omarchy-greeter-selected
  echo ">> Log out and back in so a running desktop switches back to Omarchy's lock screen."
}
