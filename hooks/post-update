#!/bin/bash
# omarchy-greeter: re-clone and re-patch the lock screen after every Omarchy
# update, so the primary-monitor lock keeps Omarchy's latest lock fixes.
if [[ -x /usr/bin/omarchy-greeter-lock-setup && -d $HOME/.config/omarchy/plugins/${USER}.lock ]]; then
  /usr/bin/omarchy-greeter-lock-setup || true
fi
