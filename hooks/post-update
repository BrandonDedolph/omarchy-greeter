#!/bin/bash
# omarchy-greeter: re-patch the lock screen after an Omarchy update changed
# the built-in lock, so the improved lock keeps Omarchy's latest fixes.
if [[ -x /usr/bin/omarchy-greeter-lock-setup && -d $HOME/.config/omarchy/plugins/${USER}.lock ]]; then
  /usr/bin/omarchy-greeter-lock-setup --if-changed || true
fi
