#!/bin/bash
# Runs every test: tests/test_*.py (unittest) and tests/test_*.sh (bash).
# Everything runs in temporary folders; nothing touches the real system.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
failed=0
for t in tests/test_*.py; do
  echo "== $t"
  python3 -I "$t" || failed=1
done
for t in tests/test_*.sh; do
  echo "== $t"
  bash "$t" || failed=1
done
(( failed )) && { echo "SOME TESTS FAILED"; exit 1; }
echo "all tests passed"
