[Unit]
Description=Tell the login screen this account has a session running
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/omarchy-greeter-presence start
ExecStop=/usr/bin/omarchy-greeter-presence stop

[Install]
WantedBy=graphical-session.target
