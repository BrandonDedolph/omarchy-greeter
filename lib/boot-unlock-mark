#!/bin/bash
# Runs once at boot, before the login screen. Marks that the first login may
# skip the account password, but only when the disk password was typed on
# this boot, and only for the accounts named in /etc/omarchy-greeter.conf
# (boot_unlock=alice,bob):
#   - / is on LUKS, so reaching here at all needed the disk unlocked;
#   - that LUKS volume has no TPM2/FIDO2/other token and no key file is
#     given to it (kernel command line, crypttab, initramfs files,
#     /etc/cryptsetup-keys.d), so a typed passphrase is the only way it could
#     unlock;
#   - SDDM has no autologin configured (that would log someone in without the
#     mark being used, leaving it for anyone who picks another account);
#   - the kernel booted moments ago and this is not a soft-reboot.
# The mark lives in /run (RAM), holds the allowed accounts, is used up by the
# first login, and is removed 10 minutes after boot. Anything unexpected
# leaves no mark: you just type your password as usual. The reason is kept in
# /run/omarchy-greeter/boot-unlock-status for `omarchy-greeter status`.
set -uo pipefail

FLAG_DIR=/run/omarchy-greeter
FLAG=$FLAG_DIR/boot-unlocked
# The same accounts, readable by the login screen so it can say "press Enter".
HINT=$FLAG_DIR/boot-unlock-hint
STATUS=$FLAG_DIR/boot-unlock-status
# Written the first time this runs on a boot; never re-arm while it exists.
DONE=$FLAG_DIR/boot-unlock-armed
WINDOW=600

install -d -m 755 -o root -g root "$FLAG_DIR"
rm -f "$FLAG" "$HINT"
status() { printf '%s\n' "$*" > "$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"; }
off() { echo "boot-unlock: $*"; status "off: $*"; exit 0; }

# Once per kernel boot. A soft-reboot (systemctl soft-reboot) restarts
# userspace without the disk password, keeping the kernel, its uptime and
# possibly /run, so check both.
if [[ -e $DONE ]]; then echo "boot-unlock: already armed once on this boot"; exit 0; fi
soft=$(systemctl show -p SoftRebootsCount --value 2>/dev/null)
[[ $soft == 0 ]] || off "soft-reboot detected (${soft:-unknown}); not a fresh boot"
cat /proc/sys/kernel/random/boot_id > "$DONE"

conf_value() { sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*([^[:space:]#]*).*/\1/p" /etc/omarchy-greeter.conf 2>/dev/null | tail -n1; }
allowed=$(conf_value boot_unlock)
[[ $allowed == yes ]] && off "boot_unlock=yes is from an older version; name the accounts with: omarchy-greeter boot-pass on"
[[ -n $allowed && $allowed != no ]] || off "turned off in /etc/omarchy-greeter.conf"
[[ $allowed =~ ^[a-z_][a-z0-9_-]{0,31}(,[a-z_][a-z0-9_-]{0,31})*$ ]] || off "boot_unlock is not a list of account names"

uptime=$(cut -d. -f1 /proc/uptime)
[[ $uptime =~ ^[0-9]+$ ]] && (( uptime < 300 )) || off "not a fresh boot (uptime ${uptime}s)"

# SDDM autologin (Omarchy sets one up for some installs).
# Read in SDDM's order: /etc/sddm.conf has the last word.
autologin=$(cat /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf /etc/sddm.conf 2>/dev/null |
  awk '/^[[:space:]]*\[/{s=$0; gsub(/[[:space:]]/,"",s)} s=="[Autologin]" && /^[[:space:]]*User[[:space:]]*=/ {sub(/^[^=]*=[[:space:]]*/,""); u=$0} END{print u}')
[[ -z $autologin ]] || off "SDDM logs $autologin in automatically"

cmdline=$(</proc/cmdline)
[[ $cmdline =~ (^|[[:space:]])(cryptkey|rd\.luks\.key|luks\.key)= ]] && off "the disk unlocks with a key file (kernel command line)"
[[ $cmdline =~ (^|[[:space:]])(rd\.)?luks\.options=[^[:space:]]*(keyfile|try-empty-password|tpm2|fido2|pkcs11) ]] &&
  off "the kernel command line gives the disk another way to unlock"
if [[ -e /etc/crypttab.initramfs ]] &&
  awk '!/^[[:space:]]*(#|$)/ && (($3 != "" && $3 != "none" && $3 != "-") || $4 ~ /(keyfile|try-empty-password|tpm2|fido2|pkcs11)/) {found=1} END{exit !found}' /etc/crypttab.initramfs; then
  off "/etc/crypttab.initramfs names a key file or token"
fi
if [[ -d /etc/cryptsetup-keys.d ]] && [[ -n $(ls -A /etc/cryptsetup-keys.d 2>/dev/null) ]]; then
  off "/etc/cryptsetup-keys.d holds key files"
fi
# FILES= in mkinitcpio's config, read the way mkinitcpio reads it (array or
# string, one line or several).
# A sentinel proves the configs were read to the end; anything else (a
# config that fails to source) counts as "maybe a key file".
bundled=$(
  set +eu
  FILES=()
  for f in /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf; do
    [[ -f $f ]] && source "$f" >/dev/null 2>&1 < /dev/null
  done
  printf 'ok:%s' "${FILES[*]}" | tr -d '[:space:]'
)
[[ $bundled == "ok:" ]] || off "the initramfs bundles extra files (FILES=), possibly a key file"

source=$(findmnt -no SOURCE / | sed 's/\[.*//')
[[ $source == /dev/mapper/* ]] || off "/ is not on dm-crypt ($source)"
device=$(cryptsetup status "$source" 2>/dev/null | awk '$1=="device:"{print $2}')
[[ -n $device ]] || off "cannot find the device under $source"
cryptsetup isLuks "$device" || off "$device is not LUKS"
tokens=$(cryptsetup luksDump --dump-json-metadata "$device" 2>/dev/null | jq '.tokens | length' 2>/dev/null)
[[ $tokens == 0 ]] || off "$device has ${tokens:-unknown} unlock tokens (TPM/FIDO)"

# The mark: when it was set, and who may use it.
printf '%s %s\n' "$uptime" "$allowed" > "$FLAG.tmp" && chmod 600 "$FLAG.tmp" && mv -f "$FLAG.tmp" "$FLAG"
printf '%s\n' "$allowed" > "$HINT.tmp" && chmod 644 "$HINT.tmp" && mv -f "$HINT.tmp" "$HINT"
status "armed for $allowed until $WINDOW s after boot"
echo "boot-unlock: disk password was typed this boot; the first login by $allowed may skip the account password for $((WINDOW - uptime))s"

# Take the mark away when the window closes, if no one has used it.
sleep $((WINDOW - uptime))
rm -f "$HINT"
rm -f "$FLAG" && echo "boot-unlock: window closed" && status "used or expired"
