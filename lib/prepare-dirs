#!/bin/bash
# Runs at boot, before the login screen (and again after install, upgrade
# or a new account):
#  1. gives every human account its own private folder under
#     /var/lib/omarchy-greeter, where it publishes its look;
#  2. publishes each account's look and display sizing (as that account, with
#     omarchy-greeter-sync --offline), so the login screen shows every account
#     the way it looks on its desktop, logged in this boot or not;
#  3. checks and copies each look into .view/<account> for the login screen
#     (publish-view), and watches the folder for later changes.
set -uo pipefail
ROOT=/var/lib/omarchy-greeter
install -d -m 755 -o root -g root "$ROOT"

read -r uid_min uid_max < <(awk '/^UID_MIN/{a=$2} /^UID_MAX/{b=$2} END{print (a?a:1000), (b?b:60000)}' /etc/login.defs)

accounts=()
while IFS=: read -r name _ uid gid _ home shell; do
  (( uid >= uid_min && uid <= uid_max )) || continue
  [[ $shell == */nologin || $shell == */false ]] && continue
  # Names that are also safe as folder names here (no dots, no slashes).
  [[ $name =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || continue
  dir="$ROOT/$name"
  # Never follow a link someone planted in place of the folder.
  [[ -L $dir ]] && rm -f "$dir"
  install -d -m 700 -o "$uid" -g "$gid" "$dir"
  # (Nothing in the folder is read here: publish-view opens those files
  # safely, and drops a stale session marker.)
  accounts+=("$name")

  [[ -d $home ]] || continue
  timeout 30 runuser -u "$name" -- env -i HOME="$home" USER="$name" LOGNAME="$name" \
    PATH=/usr/local/bin:/usr/bin:/usr/share/omarchy/bin \
    /usr/bin/omarchy-greeter-sync --offline < /dev/null ||
    echo "prepare-dirs: could not publish $name's look"
done < <(getent passwd)

# Views of accounts that no longer exist.
if [[ -d $ROOT/.view && ! -L $ROOT/.view ]]; then
  for view in "$ROOT"/.view/*/; do
    [[ -d $view ]] || continue
    name=$(basename "$view")
    [[ " ${accounts[*]} " == *" $name "* ]] || rm -rf --one-file-system -- "${view%/}"
  done
fi

# Check every look in parallel, waiting at most a minute in all (a slow one
# keeps its previous view and finishes in the background).
(( ${#accounts[@]} )) || exit 0
views=() paths=()
for name in "${accounts[@]}"; do
  views+=("omarchy-greeter-view@$name.service")
  paths+=("omarchy-greeter-view@$name.path")
done
systemctl start --no-block "${paths[@]}"
timeout 60 systemctl start "${views[@]}" || echo "prepare-dirs: some looks are still being checked"
